# Vitalcap Outreach OS — environment variable names only. NEVER commit real secrets.
# Copy to .env.local for local development. Every value below is a placeholder name,
# not a working credential. See docs/PROVIDERS.md for what each one is used for and
# which adapters currently ship as mock/dev implementations.

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
# Enables the in-memory dev seed data layer instead of a real database.
# Must be "false" in any deployed environment once Phase 1 ships real persistence.
DEV_SEED_MODE=true

# ── Supabase (provisioned in Phase 1 — not required for Phase 0) ─────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Browser-safe: NEXT_PUBLIC_* is bundled client-side by Next.js by design.
# Safe to expose because it only grants RLS-scoped anon access, never bypasses it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. NEVER expose to the browser / NEXT_PUBLIC_* prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ── Background jobs / cron ────────────────────────────────────────────────────
CRON_SECRET=

# ── Discovery providers (Phase 2) ─────────────────────────────────────────────
MAPS_PROVIDER_API_KEY=
SERP_PROVIDER_API_KEY=

# ── Enrichment / verification (Phase 2) ───────────────────────────────────────
EMAIL_VERIFICATION_PROVIDER_API_KEY=

# ── Outreach delivery (Phase 3) ───────────────────────────────────────────────
INSTANTLY_API_KEY=
SMS_PROVIDER_API_KEY=
# Global outbound safety switch. Must default to dry_run; only an authorized
# operator changes this at go-live per campaign, never in source code.
DEFAULT_DELIVERY_MODE=dry_run

# ── AI Setter (Phase 4) ────────────────────────────────────────────────────────
LLM_PROVIDER_API_KEY=

# ── Commercial configuration (never hard-code these in source) ───────────────
DEFAULT_BOOKING_URL=
